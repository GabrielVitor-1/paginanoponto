    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
